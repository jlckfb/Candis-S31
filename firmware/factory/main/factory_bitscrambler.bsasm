# Transpose eight input bytes into eight output bytes, one bit plane per byte.
cfg eof_on downstream
cfg trailing_bytes 8
cfg prefetch true

loop:
    set 0 0,
    set 1 8,
    set 2 16,
    set 3 24,
    set 4 32,
    set 5 40,
    set 6 48,
    set 7 56,
    set 8 1,
    set 9 9,
    set 10 17,
    set 11 25,
    set 12 33,
    set 13 41,
    set 14 49,
    set 15 57,
    set 16 2,
    set 17 10,
    set 18 18,
    set 19 26,
    set 20 34,
    set 21 42,
    set 22 50,
    set 23 58,
    set 24 3,
    set 25 11,
    set 26 19,
    set 27 27,
    set 28 35,
    set 29 43,
    set 30 51,
    set 31 59,
    write 32

    set 0 4,
    set 1 12,
    set 2 20,
    set 3 28,
    set 4 36,
    set 5 44,
    set 6 52,
    set 7 60,
    set 8 5,
    set 9 13,
    set 10 21,
    set 11 29,
    set 12 37,
    set 13 45,
    set 14 53,
    set 15 61,
    set 16 6,
    set 17 14,
    set 18 22,
    set 19 30,
    set 20 38,
    set 21 46,
    set 22 54,
    set 23 62,
    set 24 7,
    set 25 15,
    set 26 23,
    set 27 31,
    set 28 39,
    set 29 47,
    set 30 55,
    set 31 63,
    write 32,
    read 32

    read 32,
    jmp loop
